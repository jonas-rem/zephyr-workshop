config TELEMETRY_ENV_SENSOR_INIT_PRIORITY
	int "Environment sensor init priority"
	default 80
	help
	  SYS_INIT priority within the APPLICATION level. Lower numbers run
	  earlier, so the modules that read the sensor come up after it.

module = TELEMETRY_ENV_SENSOR
module-str = env_sensor
source "subsys/logging/Kconfig.template.log_config"
