menuconfig TELEMETRY_STATUS_LED
	bool "Mesh status LED"
	depends on TELEMETRY_MESH && GPIO
	default y
	help
	  Light LD1 while the node is attached to the mesh.

if TELEMETRY_STATUS_LED

config TELEMETRY_STATUS_LED_INIT_PRIORITY
	int "Init priority"
	default 90
	help
	  SYS_INIT priority within the APPLICATION level.

module = TELEMETRY_STATUS_LED
module-str = status_led
source "subsys/logging/Kconfig.template.log_config"

endif # TELEMETRY_STATUS_LED
