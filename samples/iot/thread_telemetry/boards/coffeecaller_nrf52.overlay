 * SPDX-License-Identifier: Apache-2.0
 *
 * Drive the on-board WS2812 strip over SPI instead of bit-banged GPIO.
 * See the sample documentation for why.
 */

#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/* At 4 MHz one SPI bit is 250 ns, so 0x70 is 750 ns high and 0x40 is 250 ns. */
#define WS2812_SPI_FREQ   4000000
#define WS2812_ZERO_FRAME 0x40
#define WS2812_ONE_FRAME  0x70

/*
 * The strip data line. This is the pin the WS2812 chain is wired to.
 */
#define WS2812_MOSI_PORT 0
#define WS2812_MOSI_PIN  26

/*
 * SPIM will not clock without an SCK pin, so one has to be spent even though
 * the strip never sees it. P0.15 is a free pin on the 2x8 header of board
 * revision 1.0.x and is not routed at all on revision 0.9.0. Change this if
 * the header pin is needed for something else; any otherwise unused pin works,
 * and it carries a 4 MHz burst whenever the strip is refreshed.
 */
#define WS2812_SCK_PORT 0
#define WS2812_SCK_PIN  15

&led_strip {
	status = "disabled";
};

&pinctrl {
	spi1_ws2812: spi1_ws2812 {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, WS2812_SCK_PORT, WS2812_SCK_PIN)>,
				<NRF_PSEL(SPIM_MOSI, WS2812_MOSI_PORT, WS2812_MOSI_PIN)>;
		};
	};

	spi1_ws2812_sleep: spi1_ws2812_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, WS2812_SCK_PORT, WS2812_SCK_PIN)>,
				<NRF_PSEL(SPIM_MOSI, WS2812_MOSI_PORT, WS2812_MOSI_PIN)>;
			low-power-enable;
		};
	};
};

&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi1_ws2812>;
	pinctrl-1 = <&spi1_ws2812_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip_spi: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;
		spi-max-frequency = <WS2812_SPI_FREQ>;

		chain-length = <4>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		spi-one-frame = <WS2812_ONE_FRAME>;
		spi-zero-frame = <WS2812_ZERO_FRAME>;
	};
};

/ {
	aliases {
		led-strip = &led_strip_spi;
	};
};
