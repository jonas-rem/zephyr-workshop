{
  "name": "Zephyr Workshop",
  "image": "ghcr.io/jonas-rem/zephyr-workshop/devcontainer:latest",
  "workspaceFolder": "/workspaces",
  "postCreateCommand": "bash /workspaces/zephyr-workshop/.devcontainer/post-create.sh",
  "waitFor": "postCreateCommand",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "remoteEnv": {
    "LC_ALL": "C",
    "CCACHE_IGNOREOPTIONS": "-specs=* --specs=*",
    "ZEPHYR_BASE": "/opt/zephyrproject/zephyr",
    "ZEPHYR_EXTRA_MODULES": "/workspaces/zephyr-workshop"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.colorTheme": "Dark Modern",
        "workbench.preferredDarkColorTheme": "Dark Modern",
        "workbench.startupEditor": "none",
        "workbench.tips.enabled": false,
        "workbench.welcomePage.walkthroughs.openOnInstall": false,
        "workbench.tree.indent": 20,
        "update.showReleaseNotes": false,
        "editor.minimap.enabled": false,
        "[c]": {
          "editor.inlayHints.enabled": "off"
        },
        "breadcrumbs.enabled": false,
        "extensions.ignoreRecommendations": true,
        "extensions.closeExtensionDetailsOnViewChange": true,
        "security.workspace.trust.startupPrompt": "never",
        "security.workspace.trust.banner": "never",
        "telemetry.telemetryLevel": "off",
        "nrf-connect.enableTelemetry": false,
        "C_Cpp.showInitialConfiguration": false,
        "C_Cpp.showOnlineInstallationValidationNotifications": false,
        "C_Cpp.intelliSenseCachePath": "",
        "C_Cpp.intelliSenseEngine": "disabled",
        "cmake.configureOnOpen": false,
        "cmake.enableAutomaticKitScan": false,
        "cmake.showOptionsMovedNotification": false,
        "cmake.showConfigureWithDebuggerNotification": false,
        "git.autofetch": false,
        "clangd.checkUpdates": false,
        "clangd.onConfigChanged": "restart",
        "clangd.onConfigChangedForceEnable": true,
        "clangd.arguments": [
					"--header-insertion=never",
					"--query-driver=/opt/zephyr-sdk/current/**/bin/*,/usr/bin/gcc,/usr/bin/g++"
				]
      },
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "trond-snekvik.kconfig-lang",
        "nordic-semiconductor.nrf-devicetree",
        "editorconfig.editorconfig",
        "llvm-vs-code-extensions.vscode-clangd"
      ]
    }
  }
}
